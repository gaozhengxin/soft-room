{
  "name": "soft-room",
  "version": "0.2.0",
  "description": "A tiny encrypted invitation room on Logos Messaging",
  "main": "index.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "node scripts/serve-static.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:network": "node tests/browser-static.mjs",
    "test:lan": "node tests/browser-static.mjs",
    "test:mesh": "node tests/browser-mesh.mjs",
    "test:mesh:engine": "node tests/browser-mesh-engine.mjs",
    "test:channels": "node tests/browser-channels.mjs",
    "test:files": "node tests/browser-files.mjs",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:ipa": "npm run ios:sync && bash scripts/build-ios-unsigned.sh",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "8.5.1",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@waku/core": "0.0.40",
    "@waku/sdk": "^0.0.36"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@types/node": "^22.20.2",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "private": true
}
