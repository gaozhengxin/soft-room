# Pure static runtime: no backend secrets or proxy settings.
# Local HTTPS static preview listens on 5173; override with PORT if desired.

# Future Capacitor bundle: public Cloudflare site for invitation URLs and region lookup.
# VITE_PUBLIC_ORIGIN=https://your-project.pages.dev

# Cloudflare TURN credential Worker URL. No secret in VITE_* variables.
# VITE_TURN_CREDENTIALS_URL=https://soft-room-turn.<account>.workers.dev/ice
