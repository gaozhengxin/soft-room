	<string>Use your microphone for voice channels and push-to-talk. 使用麦克风进行语音通话和对讲。</string>
	<key>NSCameraUsageDescription</key>
	<string>Use your camera when you enable video in a channel. 开启频道视频时使用摄像头。</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connect directly to people on your local network. 与同一局域网中的频道成员直接连接。</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
	</array>
</dict>
</plist>
